# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Vercel Postgres connection URL (required in production; falls back to in-memory store if absent)
# Set automatically when you link a Vercel Postgres database to your project.
POSTGRES_URL=

# Secret to protect the /api/db-migrate endpoint. Generate with: openssl rand -base64 32
MIGRATE_SECRET=

# Monday.com integration (optional — CSV export works without these)
# Get your API token from Monday.com → Profile → Developers → My Access Tokens
MONDAY_API_KEY=
# Board ID — found in the board URL: monday.com/boards/<BOARD_ID>
# Groups (Time Entries, Expenses, Timesheets) are created automatically on first sync.
MONDAY_TIME_TRACKER_BOARD_ID=
