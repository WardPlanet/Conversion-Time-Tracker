# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Monday.com integration (optional — CSV export works without these)
# Get your API token from Monday.com → Profile → Developers → My Access Tokens
MONDAY_API_KEY=
# Board IDs — found in the board URL: monday.com/boards/<BOARD_ID>
MONDAY_BOARD_TIME_ENTRIES=
MONDAY_BOARD_EXPENSES=
MONDAY_BOARD_TIMESHEETS=
